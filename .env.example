# Copy this file to .env and adjust the values for your setup.

# Name of the Ollama model the agent should use.
# Make sure the model is pulled locally first, for example: ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# Maximum number of reasoning/tool steps the agent may take before stopping.
# Acts as a safety limit against infinite loops and runaway cost.
MAX_AGENT_STEPS=6

# Path to the sales dataset the tools operate on.
DATA_PATH=./data/sales_data.csv
